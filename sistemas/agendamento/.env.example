# Copie para .env.local e preencha com os dados do projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Só no servidor (nunca NEXT_PUBLIC_): usada no cadastro pelo link de convite. Supabase > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
